# ── ÖRNEK ORTAM DEĞİŞKENLERİ ──────────────────────────────────────
# Gerçek değerleri .env dosyasına koy (repo'ya GİRMEZ — .gitignore).
# Railway'de bu değişkenler servis "Variables" sekmesinden girilir.

# PostgreSQL bağlantısı.
#   - BOŞ/TANIMSIZ  → yerel SQLite (02_VERI/bahis_agent.db) kullanılır.
#   - Dolu          → PostgreSQL kullanılır (psycopg2).
# Railway'de Postgres eklendiğinde otomatik sağlanır; web+worker servislerine
# referans değişken olarak bağlanır:  DATABASE_URL = ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://user:password@host:5432/dbname

# iddaa.com kaynak adresleri (varsayılanlar koda gömülü; override için).
IDDAA_BASE_SPORTSBOOK=https://sportsbookv2.iddaa.com
IDDAA_BASE_STATISTICS=https://statisticsv2.iddaa.com

# Streamlit (Railway $PORT'u otomatik sağlar; yerelde gerek yok).
# PORT=8500
